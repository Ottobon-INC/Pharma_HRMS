{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "capacitor.config.ts",
    "src-patches/**/*"
  ],
  "exclude": [
    "node_modules",
    "android"
  ]
}
